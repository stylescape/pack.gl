{
    "name": "kist",
    "description": "Package Pipeline Processor",
    "version": "0.1.45",
    "config": {
        "version_short": "0.1"
    },
    "keywords": [
        "kist",
        "package",
        "packager",
        "build",
        "builder",
        "compile",
        "compiler",
        "framework",
        "web"
    ],
    "homepage": "https://www.getkist.com/",
    "author": "Lars van Vianen <lars@vianen.com> (https://vianen.com)",
    "contributors": [
        "Scape Agency <info@scape.agency>"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/getkist/kist.git"
    },
    "bugs": {
        "url": "https://github.com/getkist/kist/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/scape-foundation"
        }
    ],
    "main": "src/ts/index.ts",
    "type": "module",
    "module": "dist/js/index.js",
    "bin": {
        "kist": "js/cli.js"
    },
    "scripts": {
        "format": "npx prettier --write .",
        "lint": "eslint 'src/**/*.ts' || true",
        "prettify": "prettier --write 'src/**/*.ts'",
        "build2": "npm run build-compile && npm run build-process && npm run test-cli-live",
        "build": "npm run build-compile && npm run build-process",
        "build-compile": "tsc -p bin/tsconfig.json",
        "build-process": "node bin/js/index.js",
        "build-tsc": "tsc -p ./tsconfig.json",
        "test-cli": "node dist/js/cli.js",
        "test-cli-live": "node dist/js/cli.js $*",
        "test-dev": "npm run build && npm run test-cli-live",
        "test": "node --loader ts-node/esm scripts/run-tests.ts"
    },
    "dependencies": {
        "@babel/core": "^7.28.3",
        "@babel/preset-env": "^7.28.3",
        "@babel/preset-typescript": "^7.27.1",
        "@types/fs-extra": "^11.0.4",
        "@types/micromatch": "^4.0.9",
        "@types/nunjucks": "^3.2.6",
        "@types/svg-sprite": "^0.0.39",
        "autoprefixer": "^10.4.21",
        "canvas": "^3.1.2",
        "canvg": "^4.0.3",
        "chokidar": "^4.0.3",
        "cssnano": "^7.1.0",
        "del": "^8.0.0",
        "eslint": "^9.33.0",
        "eslint-config-prettier": "^10.1.8",
        "express": "^5.1.0",
        "express-rate-limit": "^8.0.1",
        "fantasticon": "^3.0.0",
        "fs-extra": "^11.3.1",
        "glob": "^11.0.3",
        "js-yaml": "^4.1.0",
        "jsdom": "^27.0.1",
        "lodash": "^4.17.21",
        "nunjucks": "^3.2.4",
        "postcss": "^8.5.6",
        "postcss-preset-env": "^10.2.4",
        "prettier": "^3.6.2",
        "sass": "^1.90.0",
        "semver": "^7.7.2",
        "svg-sprite": "^2.0.4",
        "svgo": "^4.0.0",
        "terser": "^5.43.1",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@types/eslint": "^9.6.1",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/jsdom": "^27.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.3.0",
        "@types/semver": "^7.7.0",
        "@types/supertest": "^6.0.3",
        "@types/ws": "^8.18.1",
        "eslint-plugin-node": "^11.1.0",
        "jest": "^30.0.5",
        "mocha": "^11.7.1",
        "stylelint": "^16.23.1",
        "stylelint-config-standard-scss": "^15.0.1",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.1",
        "ts-node": "^10.9.2",
        "tslib": "^2.8.1",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.40.0"
    },
    "overrides": {
        "chokidar": "^4.0.3"
    },
    "files": [
        "src/**",
        "dist/**"
    ],
    "jest": {
        "transform": {
            "^.+\\.tsx?$": "ts-jest"
        }
    }
}
